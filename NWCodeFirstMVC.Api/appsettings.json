{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "Default": ""
  },
  "GoogleAuth": {
    "ClientId": "819279068519-plqdbcnaucrbk0k6di0iqq97bv2cc902.apps.googleusercontent.com"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "information"
      }
    },
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "./logs/log-.txt",
          "rollingInterval": "Day"
        }
      },
      {
        "Name": "Seq",
        "Application": "NorthwindMW",
        "Args": { "ServerUrl": "https://localhost:7216/" }
      }
    ]
  },
  "AllowedHosts": "*"
}
